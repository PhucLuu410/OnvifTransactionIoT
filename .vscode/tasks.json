{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Camera",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean Camera",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "Rebuild Camera",
            "type": "shell",
            "command": "make rebuild",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}